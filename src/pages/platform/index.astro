---
import Shot from '../../components/Shot.astro';
import Backdrop from '../../components/Backdrop.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import MockHall from '../../components/MockHall.astro';
import MockOneLine from '../../components/MockOneLine.astro';
import MockCapacityBars from '../../components/MockCapacityBars.astro';
import MockWorldMap from '../../components/MockWorldMap.astro';

const tour = [
  {
    id: 'home',
    name: 'Home',
    title: 'The estate at a glance',
    lines: ['Every site on one map, colored by its worst open alarm.', 'Load, PUE and open incidents for the whole estate sit beside it.'],
  },
  {
    id: 'thermal',
    name: 'Thermal',
    title: 'Heat, from plant to inlet',
    lines: ['Rack inlets against their allowed envelope, with the cooling plant and room units on the same page.', 'A warm row can be followed back to what caused it.'],
    href: '/platform/thermal',
    link: 'Thermal and cooling',
  },
  {
    id: 'power',
    name: 'Power',
    title: 'The chain and its redundancy',
    lines: ['The path from the utility feed to the outlet as one line, with the load at each stage.', 'It shows which redundancy is still intact right now.'],
    href: '/platform/power',
    link: 'Power and capacity',
  },
  {
    id: 'capacity',
    name: 'Capacity',
    title: 'What runs out first',
    lines: ['Power, cooling, space and ports measured against what is installed.', 'The one that runs out first is named, room by room.'],
    href: '/platform/power',
    link: 'Power and capacity',
  },
  {
    id: 'visualization',
    name: 'Visualization',
    title: 'Walk it, then rewind it',
    lines: ['Building, level, room, rack and device in 3-D, with a heat map drawn from live sensors.', 'A timeline replays the last hours like video.'],
    href: '/platform/visualization',
    link: '3-D floor and replay',
  },
  {
    id: 'assets',
    name: 'Assets',
    title: 'An inventory that matches the floor',
    lines: ['Every device placed from the site down to the rack unit.', 'What discovery finds on the network is compared with what is recorded.'],
    href: '/platform/assets',
    link: 'Assets and discovery',
  },
  {
    id: 'status',
    name: 'System status',
    title: 'The monitor, monitored',
    lines: ['Collectors, data intake and alarm rules report their own health.', 'If data is late or a collector goes quiet, the console says so.'],
  },
];

const flow = [
  { name: 'Devices', icon: 'rack', text: 'IT, power and cooling equipment keep the interfaces they already expose. Nothing is installed on them.' },
  { name: 'Collectors', icon: 'tree', text: 'Collectors inside your network, at each site and on each management network, read the devices.' },
  { name: 'Secure link', icon: 'layers', text: 'Readings and events travel to the platform over an encrypted, authenticated connection.' },
  { name: 'Platform', icon: 'cube', text: 'One telemetry model stores readings, evaluates alarm rules and folds symptoms under their cause.' },
  { name: 'Console and integrations', icon: 'chart', text: 'Operators use the web console. Your other systems receive data through the open API, a live feed or email.' },
];

const modules = [
  { href: '/platform/power', icon: 'power', title: 'Power & capacity', text: 'The whole power chain, its redundancy, and how much headroom is left.' },
  { href: '/platform/thermal', icon: 'thermal', title: 'Thermal & cooling', text: 'One cooling picture from the chiller plant to the server inlet.' },
  { href: '/platform/visualization', icon: 'cube', title: '3-D floor & replay', text: 'Walk the building, read the heat map, then rewind the last hours.' },
  { href: '/platform/alarms', icon: 'bell', title: 'Alarms & incidents', text: 'One condition, one alarm, and one incident with its evidence.' },
  { href: '/platform/assets', icon: 'rack', title: 'Assets & discovery', text: 'An inventory that matches the floor, from site down to rack unit.' },
  { href: '/works-with', icon: 'plug', title: 'Works with', text: 'The equipment classes it reads and the systems it shares data with.' },
];

const estate = [
  { name: 'Site 1', load: '1.12 MW', pue: '1.38', pct: 64, sev: '', note: 'No open alarms' },
  { name: 'Site 2', load: '0.70 MW', pue: '1.46', pct: 48, sev: 'warn', note: '2 warnings' },
];

const rackUnits = [
  { u: 'U42', name: 'Top-of-rack switch', kind: 'Network' },
  { u: 'U40', name: 'Management switch', kind: 'Network' },
  { u: 'U30', name: 'Server, 2U', kind: 'Compute' },
  { u: 'U28', name: 'Server, 2U', kind: 'Compute' },
  { u: 'U26', name: 'Found on network, not recorded', kind: 'Review', flag: true },
  { u: 'U01', name: 'Rack PDU A and B', kind: 'Power' },
];

const health = [
  { name: 'Collectors', value: 'All reporting', sev: '' },
  { name: 'Newest reading', value: '4 s ago', sev: '' },
  { name: 'Alarm rules', value: 'Evaluated 12 s ago', sev: '' },
  { name: 'Collector, Site 2 plant', value: 'Late by 40 s', sev: 'warn' },
  { name: 'History storage', value: '71% free', sev: '' },
];
---

<Base
  title="Platform"
  description="One telemetry model for IT, power and cooling equipment, with the same alarm console and the same floor map for all of it."
>
  <PageHero slot="hero" pill="Platform" title="One telemetry model for white space and gray space">
    Servers, switches, PDUs, UPS, switchgear, generators, CRAHs, chillers, pumps, CDUs and fire panels in the same model,
    the same alarm console and the same floor map.
    <Shot slot="visual" name="connectivity" alt="Connectivity map: network room, server halls, UPS room, central plant and roof in one model" />
  </PageHero>

  <!-- tour -->
  <section class="section">
    <div class="wrap">
      <SectionHead pill="Tour" title="Seven menus, one model behind them" center>
        Each menu is a different question asked of the same data, so a reading means the same thing wherever you meet
        it.
      </SectionHead>
      <div class="tour" data-tabs>
        <div class="tour__tabs" role="tablist" aria-label="Platform menus" data-anim="up">
          {
            tour.map((t, k) => (
              <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={k === 0 ? 'true' : 'false'}>
                {t.name}
              </button>
            ))
          }
        </div>
        <div class="card card--grid tour__stage" data-anim="up-block">
          {
            tour.map((t) => (
              <div class="tour__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0">
                <div class="tour__text">
                  <h3>{t.title}</h3>
                  {t.lines.map((l) => (
                    <p>{l}</p>
                  ))}
                  {t.href && (
                    <a class="link-arrow" href={t.href}>
                      {t.link}
                      <span class="circle">
                        <Icon name="arrow" size={16} />
                      </span>
                    </a>
                  )}
                </div>
                <div class="tour__visual">
                  {t.id === 'home' && <Shot name="home" alt="Home: both sites with their state by power, cooling, environment, IT, network and fire" />}
                  {t.id === 'thermal' && <Shot name="thermal-top" alt="Thermal: average, p90 and maximum inlet, share in band and humidity per site" />}
                  {t.id === 'power' && <Shot name="power-top" alt="Power: load, share of rating, headroom and feed risk per site" />}
                  {t.id === 'capacity' && <Shot name="capacity" alt="Capacity: space, power and cooling used per site, and which runs out first" />}
                  {t.id === 'visualization' && <Shot name="viewer-full" alt="Visualization: the 3-D floor with room information and the replay timeline" />}
                  {t.id === 'assets' && (
                    <Shot name="assets-overview" alt="Assets overview: counts, cabinet and floor space, and how full the racks are" />
                  )}
                  {t.id === 'status' && (
                    <Shot name="platform" alt="System status: pipeline health, open conditions and collectors" />
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- data flow -->
  <section class="section pbg">
    <Backdrop view="hall" />
    <div class="wrap">
      <SectionHead pill="How data flows" title="From the device to the console in five steps">
        The platform and its collectors run on your own infrastructure, so telemetry stays inside your network.
      </SectionHead>
      <ol class="flow">
        {
          flow.map((f, k) => (
            <li class="card card--raised flow__step" data-anim="up">
              <div class="flow__head">
                <span class="tile">
                  <Icon name={f.icon} />
                </span>
                <span class="flow__n mono">{k + 1}</span>
              </div>
              <h3>{f.name}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="flow__note" data-anim="up">
        Each collector proves its identity to the platform, keeps device credentials encrypted, and runs only verified software.
      </p>
    </div>
  </section>

  <!-- standards -->
  <section class="section">
    <div class="wrap split split--top">
      <div>
        <SectionHead pill="Built to standards" title="The same yardsticks your engineers already use">
          Thresholds and alarm behavior follow published practice, so the console does not invent its own definition
          of too warm or of acknowledged.
        </SectionHead>
      </div>
      <div class="grid std">
        <div class="card card--grid std__card" data-anim="up">
          <span class="tile"><Icon name="thermal" /></span>
          <h3>ASHRAE TC 9.9 thermal envelopes</h3>
          <p>
            Rack inlet temperatures are judged against ASHRAE TC 9.9 thermal envelopes, so too warm means the same thing
            in every hall.
          </p>
        </div>
        <div class="card card--grid std__card" data-anim="up">
          <span class="tile"><Icon name="bell" /></span>
          <h3>Alarm handling aligned with ISA-18.2</h3>
          <p>
            The alarm lifecycle, priorities and operator actions are aligned with ISA-18.2. The alignment is partial
            today, and we will show you where it stops.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- modules -->
  <section class="section">
    <div class="wrap">
      <SectionHead pill="Modules" title="Go deeper into each part" center />
      <div class="grid grid-3">
        {
          modules.map((m) => (
            <a class="card card--grid mod" href={m.href} data-anim="up">
              <span class="tile">
                <Icon name={m.icon} />
              </span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
              <span class="mod__go" aria-hidden="true">
                <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* hero estate mock */
  .estate__kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .estate__kpis > div {
    padding: var(--s-4) var(--s-4);
    display: grid;
    gap: var(--s-1);
  }
  .estate__kpis > div + div {
    border-left: 1px solid var(--line);
  }
  .estate__kpis span {
    font-size: 12px;
    color: var(--muted);
  }
  .estate__kpis b {
    font-weight: 500;
    font-size: 24px;
    color: var(--head);
    white-space: nowrap;
  }
  .estate__kpis small {
    font-size: 13px;
    margin-left: 3px;
    color: var(--muted);
  }
  .estate__sites {
    list-style: none;
    margin: 0;
    padding: var(--s-3);
    display: grid;
    gap: var(--s-2);
  }
  .estate__sites li {
    padding: var(--s-4);
    border-radius: var(--r-card);
    border: 1px solid var(--line);
    background: var(--ink-0);
    display: grid;
    gap: var(--s-3);
  }
  .estate__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
  }
  .estate__top strong {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 15px;
    color: var(--head);
  }
  .estate__top small {
    font-size: 13px;
    color: var(--muted);
  }
  .estate__meter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--s-4);
    align-items: center;
    font-size: 13px;
    color: var(--body);
  }
  .estate__meter i {
    height: 8px;
    border-radius: var(--r-input);
    background: var(--ink-2);
    overflow: hidden;
  }
  .estate__meter b {
    display: block;
    height: 100%;
    border-radius: var(--r-input);
    background: linear-gradient(90deg, var(--accent-deep), var(--accent-text));
  }
  .estate__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-2) var(--s-4) var(--s-3);
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .estate__kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .estate__kpis > div:nth-child(3) {
      border-left: 0;
    }
    .estate__kpis > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* tour tabs */
  .tour__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    margin-bottom: var(--s-6);
  }
  .tour__tabs button {
    min-height: 44px;
    padding: var(--s-2) var(--s-5);
    border-radius: var(--r-round);
    border: 1px solid var(--line);
    background: var(--ink-1);
    color: var(--body);
    font-family: var(--font-head);
    font-size: 15px;
    cursor: pointer;
    transition:
      background 0.15s ease-in-out,
      color 0.15s ease-in-out,
      border-color 0.15s ease-in-out;
  }
  .tour__tabs button:hover {
    color: var(--head);
    border-color: var(--accent-text);
  }
  .tour__tabs button[aria-selected='true'] {
    background: var(--accent);
    border-color: var(--line-strong);
    color: #fff;
  }
  .tour__stage {
    padding: clamp(20px, 3vw, 44px);
  }
  .tour__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  @media (min-width: 901px) {
    .tour__panel {
      min-height: 420px;
    }
  }
  .tour__panel[hidden] {
    display: none;
  }
  .tour__panel + .tour__panel:not([hidden]) {
    margin-top: 0;
  }
  .tour__panel:not([hidden]) {
    animation: tourIn 0.45s ease both;
  }
  @keyframes tourIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tour__panel:not([hidden]) {
      animation: none;
    }
  }
  /* without JavaScript every panel is shown, so space them */
  :global(html:not(.js)) .tour__panel + .tour__panel {
    margin-top: var(--s-7);
  }
  .tour__text {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .tour__text h3 {
    font-size: clamp(24px, 2.4vw, 32px);
  }
  .tour__text .link-arrow {
    margin-top: var(--s-2);
  }
  @media (max-width: 900px) {
    .tour__panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .tour__tabs {
      justify-content: flex-start;
    }
  }

  /* small list mocks used by the Assets and System Status panels */
  .units ul {
    list-style: none;
    margin: 0;
    padding: var(--s-2);
    display: grid;
    gap: var(--s-2);
  }
  .units li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    gap: var(--s-3);
    align-items: center;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-card);
    background: var(--ink-0);
    border: 1px solid transparent;
  }
  .units li.flag {
    border-color: var(--warn);
  }
  .units li > .mono:first-child {
    font-size: 13px;
    color: var(--accent-text);
  }
  .units li > .dot {
    margin: 0;
    justify-self: center;
  }
  .units strong {
    font-weight: 500;
    font-size: 14px;
    color: var(--head);
  }
  .units em {
    font-style: normal;
    font-size: 13px;
    padding: 2px var(--s-2);
    border-radius: var(--r-round);
    background: var(--ink-2);
    color: var(--body);
    white-space: nowrap;
  }

  /* data flow */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .flow__step {
    padding: var(--s-5);
    overflow: visible;
  }
  .flow__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .flow__n {
    font-size: 14px;
    color: var(--accent-text);
  }
  .flow__step h3 {
    font-size: 20px;
  }
  .flow__step p {
    margin-top: var(--s-3);
    font-size: 15px;
  }
  /* connector between steps on one row */
  .flow__step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50px;
    width: 21px;
    height: 2px;
    background: var(--accent-text);
  }
  .flow__note {
    margin-top: var(--s-6);
    max-width: 70ch;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flow__step::after {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* standards */
  .std {
    gap: var(--s-5);
  }
  .std__card p {
    max-width: 52ch;
  }

  /* modules (same card as Home) */
  .mod {
    min-height: 270px;
  }
  .mod__go {
    position: absolute;
    right: 26px;
    bottom: 26px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink-2);
    color: var(--head);
    transition:
      background 0.15s ease-in-out,
      transform 0.2s ease;
  }
  .mod:hover .mod__go {
    background: var(--accent);
  }
  .mod p {
    max-width: 30ch;
    padding-bottom: var(--s-7);
  }
</style>
