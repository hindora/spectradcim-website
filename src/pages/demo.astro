---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const covers = [
  { t: 'Live estate overview', d: 'Every site on one screen, with what is in alarm and why.' },
  { t: 'A chiller-loss scenario', d: 'From the first alarm to a single incident with its evidence.' },
  { t: 'The power chain', d: 'From the utility feed to the outlet, with redundancy and headroom.' },
  { t: 'Thermal replay', d: 'The hall heat map, rewound through the event like video.' },
];
---

<Base
  title="Request a 30-minute DCIM demo"
  description="Request a 30-minute SpectraDCIM demo: live estate, a chiller-loss scenario, the power chain and thermal replay."
>
  <section slot="hero" class="page-hero">
    <div class="wrap split split--top">
      <div>
        <span class="pill" data-anim="up">Request a demo</span>
        <h1 data-anim="up">See your kind of site in SpectraDCIM</h1>
        <p class="lead" data-anim="up">
          Tell us what you run and we will shape the demo around it. It runs on a simulated estate with plant,
          electrical chain and IT, so nothing is needed from your network.
        </p>
        <h2 class="h3 covers__head" data-anim="up">In 30 minutes</h2>
        <ul class="checks covers">
          {
            covers.map((c) => (
              <li data-anim="up">
                <span>
                  <strong>{c.t}.</strong> {c.d}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card card--raised demo-form" data-anim="up-block">
        <form class="form" data-demo-form data-form-name="Demo request">
          <div class="row">
            <div class="field">
              <label for="dm-name">Name <span class="req">(required)</span></label>
              <input id="dm-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="dm-email">Work email <span class="req">(required)</span></label>
              <input id="dm-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <div class="row">
            <div class="field">
              <label for="dm-company">Company <span class="req">(required)</span></label>
              <input id="dm-company" name="company" type="text" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="dm-role">Role</label>
              <input id="dm-role" name="role" type="text" autocomplete="organization-title" />
            </div>
          </div>
          <div class="field">
            <label for="dm-sites">Number of sites</label>
            <input id="dm-sites" name="sites" type="number" min="1" step="1" inputmode="numeric" autocomplete="off" />
          </div>
          <div class="field">
            <label for="dm-message">Message</label>
            <textarea id="dm-message" name="message" autocomplete="off" aria-describedby="dm-message-note"></textarea>
            <p class="form__note" id="dm-message-note">What would you most like to see? Power, cooling, alarms or the floor view.</p>
          </div>
          <button class="btn" type="submit"><span>Request a demo</span></button>
          <p class="form__status" data-form-status hidden tabindex="-1" role="status"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap other">
      <p data-anim="up">Looking for something else?</p>
      <a class="link-arrow" href="/partners" data-anim="up">
        Become a partner
        <span class="circle"><Icon name="arrow" size={16} /></span>
      </a>
      <a class="link-arrow" href="/company#contact" data-anim="up">
        General contact
        <span class="circle"><Icon name="arrow" size={16} /></span>
      </a>
    </div>
  </section>
</Base>

<style>
  .covers__head {
    margin-top: var(--s-7);
  }
  .covers {
    margin-top: var(--s-5);
    max-width: 52ch;
  }
  .demo-form .form__note {
    margin-top: var(--s-2);
  }
  .req {
    color: var(--muted);
    font-size: 14px;
  }
  .form .btn {
    justify-self: start;
  }
  .other {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .other p {
    color: var(--muted);
    margin-right: auto;
  }
</style>
