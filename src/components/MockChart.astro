---
// Glowing trend line with one highlighted point. Illustrative values only.
interface Props {
  label?: string;
  unit?: string;
  value?: string;
  /** y values 0..100, left to right */
  points?: number[];
  band?: boolean;
  mark?: number;
}
const {
  label = 'Rack inlet temperature',
  unit = '°C',
  value = '24.6',
  points = [38, 36, 40, 39, 44, 42, 47, 52, 60, 71, 78, 70, 58, 50, 46, 43],
  band = true,
  mark = 10,
} = Astro.props;
const W = 520;
const H = 220;
const pad = 14;
const xs = points.map((_, i) => pad + (i * (W - 2 * pad)) / (points.length - 1));
const ys = points.map((p) => H - pad - (p / 100) * (H - 2 * pad));
let d = `M${xs[0].toFixed(1)} ${ys[0].toFixed(1)}`;
for (let i = 1; i < xs.length; i++) {
  const mx = (xs[i - 1] + xs[i]) / 2;
  d += ` C${mx.toFixed(1)} ${ys[i - 1].toFixed(1)} ${mx.toFixed(1)} ${ys[i].toFixed(1)} ${xs[i].toFixed(1)} ${ys[i].toFixed(1)}`;
}
const area = `${d} L${xs[xs.length - 1].toFixed(1)} ${H} L${xs[0].toFixed(1)} ${H} Z`;
const uid = `ch-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="chart" role="img" aria-label={`Illustrative trend chart: ${label}`}>
  <div class="chart__head">
    <span>{label}</span>
    <strong class="mono">{value}<small>{unit}</small></strong>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    <defs>
      <linearGradient id={`${uid}-a`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7e91cb" stop-opacity=".38"></stop>
        <stop offset="1" stop-color="#7e91cb" stop-opacity="0"></stop>
      </linearGradient>
      <filter id={`${uid}-g`} x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="5"></feGaussianBlur>
      </filter>
    </defs>
    {band && <rect x="0" y={H * 0.36} width={W} height={H * 0.4} fill="rgba(126,145,203,.07)" />}
    {[0.2, 0.4, 0.6, 0.8].map((f) => <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="rgba(255,255,255,.06)" />)}
    <path d={area} fill={`url(#${uid}-a)`}></path>
    <path d={d} fill="none" stroke="#7e91cb" stroke-width="6" opacity=".55" filter={`url(#${uid}-g)`}></path>
    <path d={d} fill="none" stroke="#a9b8e6" stroke-width="2.5" stroke-linecap="round"></path>
    <line x1={xs[mark]} x2={xs[mark]} y1={ys[mark]} y2={H} stroke="rgba(241,242,255,.35)" stroke-dasharray="3 4"></line>
    <circle cx={xs[mark]} cy={ys[mark]} r="11" fill="#7e91cb" opacity=".3"></circle>
    <circle cx={xs[mark]} cy={ys[mark]} r="5.5" fill="#f1f2ff"></circle>
  </svg>
</div>

<style>
  .chart {
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #06070f;
    overflow: hidden;
  }
  .chart__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 14px 16px 0;
    font-size: 13px;
    color: var(--muted);
  }
  .chart__head strong {
    font-size: 26px;
    font-weight: 500;
    color: var(--head);
  }
  .chart__head small {
    font-size: 13px;
    margin-left: 4px;
    color: var(--muted);
  }
  .chart svg {
    width: 100%;
    height: 190px;
  }
</style>
