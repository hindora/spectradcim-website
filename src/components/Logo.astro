---
// The original SpectraDCIM logo (mark and wordmark), with its dark background removed.
// Source artwork: assets/brand/spectradcim-logo-original.png
import dims from '../../public/brand/_logo.json';
interface Props {
  /** displayed height in px */
  size?: number;
}
const { size = 56 } = Astro.props;
const width = Math.round((dims.w / dims.h) * size);
---

<a class="logo" href="/" aria-label="SpectraDCIM home">
  <img src="/brand/spectradcim-logo.png" width={width} height={size} alt="SpectraDCIM" decoding="async" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo img {
    display: block;
    height: auto;
    max-width: 100%;
  }
</style>
