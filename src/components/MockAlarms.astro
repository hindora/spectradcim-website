---
// Stylized alarm console: one summary line with its folded symptoms. Illustrative values only.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const rows = [
  { sev: 'crit', what: 'Chiller plant: chilled water supply lost', where: 'Plant / CHW loop', n: '1 cause', t: '14:02:11' },
  { sev: 'warn', what: 'Hall A: supply air temperature rising', where: 'Hall A / CRAH 1 to 6', n: '6 folded', t: '14:02:40' },
  { sev: 'warn', what: 'Row 3: rack inlet above allowed band', where: 'Hall A / Row 3', n: '48 folded', t: '14:03:25' },
  { sev: 'info', what: 'Servers: fan speed raised', where: 'Hall A', n: '212 folded', t: '14:03:58' },
];
const shown = compact ? rows.slice(0, 3) : rows;
---

<div class="mock alarms" role="img" aria-label="Illustration of the alarm console showing one cause with its symptoms folded beneath it">
  <div class="mock__bar"><i></i><i></i><i></i>Alarm Console<span class="mono">9 lines / 727 raw</span></div>
  <ul>
    {
      shown.map((r, k) => (
        <li class:list={{ lead: k === 0 }}>
          <span class={`dot dot--${r.sev === 'info' ? 'info' : r.sev}`} />
          <div>
            <strong>{r.what}</strong>
            <small>{r.where}</small>
          </div>
          <em>{r.n}</em>
          <time class="mono">{r.t}</time>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .alarms ul {
    list-style: none;
    margin: 0;
    padding: var(--s-2);
    display: grid;
    gap: var(--s-2);
  }
  .alarms li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto auto;
    gap: var(--s-3);
    align-items: center;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-card);
    background: var(--ink-0);
    border: 1px solid transparent;
  }
  .alarms li:not(.lead) {
    margin-left: var(--s-5);
  }
  .alarms li.lead {
    border-color: rgba(229, 72, 77, 0.45);
    background: linear-gradient(90deg, rgba(229, 72, 77, 0.14), var(--ink-0) 60%);
  }
  .alarms strong {
    display: block;
    font-weight: 500;
    color: var(--head);
    font-size: 14px;
  }
  .alarms small {
    color: var(--muted);
    font-size: 13px;
  }
  .alarms em {
    font-style: normal;
    font-size: 13px;
    padding: 2px var(--s-2);
    border-radius: var(--r-round);
    background: var(--ink-2);
    color: var(--body);
    white-space: nowrap;
  }
  .alarms time {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .alarms time {
      display: none;
    }
  }
</style>
