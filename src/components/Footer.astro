---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Backdrop from './Backdrop.astro';
const year = new Date().getFullYear();
const cols = [
  {
    title: 'Platform',
    links: [
      ['/platform', 'Overview'],
      ['/platform/power', 'Power & Capacity'],
      ['/platform/thermal', 'Thermal & Cooling'],
      ['/platform/visualization', '3-D Floor & Replay'],
      ['/platform/alarms', 'Alarms & Incidents'],
      ['/platform/assets', 'Assets & Discovery'],
    ],
  },
  {
    title: 'Explore',
    links: [
      ['/solutions', 'Solutions'],
      ['/works-with', 'Works With'],
      ['/resources', 'Resources'],
      ['/early-access', 'Early Access'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['/company', 'About'],
      ['/partners', 'Partners'],
      ['/demo', 'Request A Demo'],
    ],
  },
];
---

<footer class="ftr pbg">
  <Backdrop view="site" focus="center 40%" />
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand" data-anim="up">
        <Logo />
        <p>
          Power, cooling and IT in one system, watched as one. Self-hosted data centre infrastructure management, now in
          early access.
        </p>
      </div>
      {
        cols.map((c) => (
          <nav class="ftr__col" aria-label={c.title} data-anim="up">
            <h3>{c.title}</h3>
            <ul>
              {c.links.map(([href, label]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="ftr__contact" data-anim="up">
      <a href="/demo"><span class="ico"><Icon name="mail" size={20} /></span>Talk to the team</a>
      <a href="/early-access"><span class="ico"><Icon name="flag" size={20} /></span>Apply for early access</a>
      <a href="/partners"><span class="ico"><Icon name="handshake" size={20} /></span>Become a partner</a>
    </div>
    <div class="ftr__legal">
      <p>Copyright {year} SpectraDCIM. All rights reserved.</p>
      <p>Views show SpectraDCIM on a simulated estate. Map imagery: NASA GIBS, NOAA GOES, RainViewer.</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-top: clamp(80px, 10vw, 140px);
    padding-bottom: 34px;
  }
  .ftr__top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .ftr__brand p {
    margin-top: 22px;
    max-width: 38ch;
  }
  .ftr__col h3 {
    font-size: 20px;
    margin-bottom: 22px;
  }
  .ftr__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .ftr__col a {
    color: var(--body);
  }
  .ftr__col a:hover {
    color: var(--accent-text);
  }
  .ftr__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 46px;
    margin-top: 60px;
    padding: 28px 0;
    border-block: 1px solid var(--line);
  }
  .ftr__contact a {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--head);
  }
  .ftr__contact a:hover {
    color: var(--accent-text);
  }
  .ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent-tile);
    color: var(--head);
  }
  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-top: 26px;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .ftr__top {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .ftr__top {
      grid-template-columns: 1fr;
    }
  }
</style>
