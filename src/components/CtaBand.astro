---
import Btn from './Btn.astro';
interface Props {
  pill?: string;
  title?: string;
  href?: string;
  label?: string;
}
const {
  pill = 'Ready To See Your Site As One System?',
  title = 'Start With A 30‑Minute Demo',
  href = '/demo',
  label = 'Request A Demo',
} = Astro.props;
---

<section class="section--tight cta-sec">
  <div class="wrap">
    <div class="cta" data-anim="up-block">
      <div class="cta__frag cta__frag--l" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </div>
      <div class="cta__frag cta__frag--r" aria-hidden="true">
        <b style="height:38%"></b><b style="height:62%"></b><b style="height:48%"></b><b style="height:80%"></b><b
          style="height:56%"></b>
      </div>
      <div class="cta__inner">
        <span class="pill pill--plain cta__pill">{pill}</span>
        <h2>{title}</h2>
        <Btn href={href} variant="dark">{label}</Btn>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-sec {
    padding-block: clamp(40px, 6vw, 90px);
  }
  .cta {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    background-color: var(--accent);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    padding: clamp(56px, 7vw, 110px) 24px;
    text-align: center;
  }
  .cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 26px;
  }
  .cta__pill {
    background: rgba(0, 0, 0, 0.28);
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }
  .cta h2 {
    color: #fff;
    max-width: 20ch;
    font-size: clamp(32px, 4.4vw, 58px);
  }
  .cta__frag {
    position: absolute;
    width: 250px;
    height: 170px;
    padding: 18px;
    border-radius: 14px;
    background: var(--ink-0);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }
  .cta__frag--l {
    left: -66px;
    top: -30px;
    transform: rotate(-12deg);
    display: grid;
    gap: 10px;
    align-content: center;
  }
  .cta__frag--l i {
    height: 12px;
    border-radius: 6px;
    background: var(--ink-2);
  }
  .cta__frag--l i:nth-child(2) {
    width: 70%;
    background: var(--accent-tile);
  }
  .cta__frag--l i:nth-child(4) {
    width: 45%;
  }
  .cta__frag--r {
    right: -60px;
    bottom: -40px;
    transform: rotate(-10deg);
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }
  .cta__frag--r b {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(var(--accent-text), var(--accent-deep));
  }
  @media (max-width: 800px) {
    .cta__frag {
      display: none;
    }
  }
</style>
