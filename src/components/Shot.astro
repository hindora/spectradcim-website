---
// A real screen from SpectraDCIM (captured on the simulated estate), not a drawing.
// Exception: the four trend charts (power-draw, power-pue, thermal-intake, thermal-band) are redrawn
// from assets/charts/charts.html in the product's chart style, because the captures had gaps in the data.
// Files live in public/shots; sizes come from _sizes.json so the page does not shift while loading.
import sizes from '../../public/shots/_sizes.json';
interface Props {
  name: string;
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;
const [w, h] = (sizes as Record<string, number[]>)[name] ?? [1600, 900];
---

<figure class="shot">
  <a href={`/shots/${name}.webp`} target="_blank" rel="noopener" aria-label={`${alt} (opens the full-size screen)`}>
    <img src={`/shots/${name}.webp`} width={w} height={h} alt={alt} loading="lazy" decoding="async" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
    border-radius: var(--r-card);
    border: 1px solid var(--line);
    background: #0b0e14;
    overflow: hidden;
  }
  .shot a {
    display: block;
    cursor: zoom-in;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot figcaption {
    padding: var(--s-2) var(--s-4);
    font-size: 14px;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
</style>
